{
  "name": "dsh-opencode-session",
  "version": "0.1.0",
  "description": "DeepSeek Harness compatibility plugin: send the x-opencode-session header opencode.ai's gateway requires on opencode / opencode-go routes.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "opencode",
    "opencode-go"
  ],
  "scripts": {
    "test": "node --test"
  }
}
